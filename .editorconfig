root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,ipynb}]
indent_size = 2

[*.{csproj,props,targets,config}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:error
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion

# Modern C# expression style
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

# Nullability and immutability are load-bearing in the domain layer
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Naming: private fields are _camelCase
dotnet_naming_rule.private_fields_underscored.symbols = private_fields
dotnet_naming_rule.private_fields_underscored.style = underscore_prefixed
dotnet_naming_rule.private_fields_underscored.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefixed.required_prefix = _
dotnet_naming_style.underscore_prefixed.capitalization = camel_case

[tests/**/*.cs]
# Test method names read as sentences: Active_subscription_recovers_from_past_due
dotnet_diagnostic.CA1707.severity = none
