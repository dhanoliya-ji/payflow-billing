# Copy to .env for local Docker Compose overrides. Defaults are baked into
# docker-compose.yml, so this file is only needed to change them.
POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=payflow

# Used when running the solution from the SDK rather than in containers.
# The ports match docker-compose.yml's published ports.
ConnectionStrings__Postgres=Host=localhost;Port=55433;Database=payflow;Username=payflow;Password=payflow
ConnectionStrings__Redis=localhost:6380

# Integration tests create their own database on this server.
PAYFLOW_TEST_POSTGRES=Host=localhost;Port=55433;Database=postgres;Username=payflow;Password=payflow

# Analytics notebook.
PAYFLOW_DATABASE_URL=postgresql+psycopg2://payflow:payflow@localhost:55433/payflow
PAYFLOW_TENANT_ID=11111111-1111-1111-1111-111111111111
